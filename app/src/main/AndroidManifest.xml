<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- لإعادة جدولة التنبيهات بعد إعادة تشغيل الهاتف -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".ScheduledMessagesApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_jasmine"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_jasmine"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScheduledMessages"
        android:localeConfig="@xml/locales_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ScheduledMessages"
            android:windowSoftInputMode="adjustResize">
        </activity>

        <!-- ==================== أيقونات التطبيق القابلة للتبديل ====================
             نظام Activity-Alias: كل alias يمثل نفس الشاشة الرئيسية لكن بأيقونة مختلفة.
             alias واحد فقط يكون enabled في أي وقت (يُدار عبر AppIconManager.kt) -->

        <activity-alias
            android:name=".IconAliasJasmine"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_jasmine"
            android:roundIcon="@mipmap/ic_launcher_jasmine"
            android:label="@string/app_name"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconAliasMoon"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_moon"
            android:roundIcon="@mipmap/ic_launcher_moon"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconAliasHeart"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_heart"
            android:roundIcon="@mipmap/ic_launcher_heart"
            android:label="@string/app_name"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Boot receiver: يعيد جدولة التحديثات بعد إعادة تشغيل الهاتف -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- المُستقبِل الذي ينفّذ تحديث الرسالة عند كل نقطة زمنية مجدولة (بداية/نهاية رسالة) -->
        <receiver
            android:name=".receiver.MessageAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- App Widgets (Glance) — بمقاسات متعددة، راجع res/xml لكل مزوّد -->
        <receiver
            android:name=".widget.ActiveMessageWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/active_message_widget_info" />
        </receiver>

    </application>

</manifest>
